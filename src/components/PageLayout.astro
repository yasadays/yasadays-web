---
import type { ComponentProps } from "astro/types";
import Root from "./Root.astro";
import Footer from "./footer/Footer.astro";
import Navbar from "./navbar/Navbar.astro";

type Props = ComponentProps<typeof Root>;
---

<Root {...Astro.props}>
  <a
    href="#main"
    class="sr-only z-50 bg-black px-4 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
  >
    Skip to content
  </a>
  <div class="relative mx-auto min-h-dvh max-w-[1440px] min-[1440px]:border-x">
    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </div>
</Root>
